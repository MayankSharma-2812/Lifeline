PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/lifeline?appName=Cluster0

# Upstash Redis (REST-based — free tier works)
UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_before_deploy

OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# PostgreSQL (Prisma polyglot audit trail - optional)
DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/<dbname>?sslmode=require

CLIENT_URL=http://localhost:5173